# When building for Android (or any non-proxied environment), set this
# to the public URL of a deployed web instance that exposes /api/finance/
# via nginx. Without it, the Portfolio tab cannot fetch live prices on
# Android because there is no Vite/nginx proxy inside the WebView.
#
# Leave empty for local dev (vite proxy) or the web Docker build (nginx).
VITE_API_BASE=
